# PostgreSQL (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=englis_vocabulary
POSTGRES_PORT=5432

# 无 Docker 本地开发（PGlite）
PGLITE_HOST=127.0.0.1
PGLITE_PORT=5432
PGLITE_DATA_DIR=./database/.pglite

# Server
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/englis_vocabulary?schema=public&pgbouncer=true&connection_limit=1
PORT=3000
API_PREFIX=api
CORS_ORIGIN=*
