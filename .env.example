# PostgreSQL (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=englis_vocabulary
POSTGRES_PORT=5432

# 无 Docker 本地开发（PGlite）
PGLITE_HOST=127.0.0.1
PGLITE_PORT=5432
PGLITE_DATA_DIR=./database/.pglite

# Server
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/englis_vocabulary?schema=public&pgbouncer=true&connection_limit=1
PORT=3000
API_PREFIX=api
CORS_ORIGIN=*

# 微信登录与小程序会话
WECHAT_APP_ID=wx9ed13f9f8cbcf771
WECHAT_APP_SECRET=
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=2592000
