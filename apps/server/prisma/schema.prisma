generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Word {
  id               String   @id @default(uuid())
  word             String   @unique
  lemma            String?
  phonetic         String?
  pronunciationUrl String?
  imageUrl         String?
  meaning          String
  example          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  learningRecords LearningRecord[]
  senses          WordSense[]
  forms           WordForm[]

  @@index([createdAt])
}

model User {
  id        String   @id @default(uuid())
  openid    String?  @unique
  nickname  String?
  timezone  String   @default("Asia/Shanghai")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  learningRecords LearningRecord[]
  userWords       UserWord[]
  writingRecords  WritingRecord[]
  userStages      UserStage[]
  userLevels      UserLevel[]
  dailyLearnings  DailyLearning[]
  dailyTasks      DailyTask[]
  reviewRecords   ReviewRecord[]
}

model LearningRecord {
  id             String    @id @default(uuid())
  userId         String
  wordId         String
  familiarity    Int       @default(0)
  reviewCount    Int       @default(0)
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId])
  @@index([wordId])
}

// ===== 第一批：课程管理（Stage / Unit / Level）=====

model Stage {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  sortOrder   Int      @default(0)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  units      Unit[]
  stageWords StageWord[]
  userStages UserStage[]

  @@index([sortOrder])
}

// ===== 第二批：词汇体系（WordSense / WordForm）=====
// 注意：Word.id 是 text 类型（旧表），所以外键 wordId 不加 @db.Uuid，
// 保持与 Word.id 类型一致，否则 Prisma 校验会失败。
// Word 的 meaning / example 字段暂时保留（现有 API 与小程序依赖），
// 词义数据通过 seed 回填到 WordSense，后续批次再评估是否移除旧字段。

model WordSense {
  id                 String   @id @default(uuid()) @db.Uuid
  wordId             String
  partOfSpeech       String
  definition         String
  englishDefinition  String?
  example            String?
  exampleTranslation String?
  mnemonic           String?
  usageNotes         String?
  sourceText         String?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  word           Word            @relation(fields: [wordId], references: [id], onDelete: Cascade)
  levelWords     LevelWord[]
  stageWords     StageWord[]
  userWords      UserWord[]
  writingRecords WritingRecord[]
  dailyTasks     DailyTask[]
  reviewRecords  ReviewRecord[]

  @@index([wordId])
  @@index([wordId, sortOrder])
}

model WordForm {
  id       String @id @default(uuid()) @db.Uuid
  wordId   String
  form     String
  formType String

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([wordId, form, formType])
  @@index([wordId])
}

model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  stageId   String   @db.Uuid
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  stage  Stage   @relation(fields: [stageId], references: [id], onDelete: Restrict)
  levels Level[]

  @@unique([stageId, sortOrder])
  @@index([stageId])
}

model Level {
  id        String   @id @default(uuid()) @db.Uuid
  unitId    String   @db.Uuid
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  unit       Unit        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  levelWords LevelWord[]
  userLevels UserLevel[]

  @@unique([unitId, sortOrder])
  @@index([unitId])
}

// ===== 第三批：课程与词汇关联（LevelWord / StageWord）=====
// Level.id / Stage.id / WordSense.id 均为 @db.Uuid，故外键也用 @db.Uuid。
// 唯一约束避免同一关卡/阶段重复关联同一个词义。

model LevelWord {
  id          String   @id @default(uuid()) @db.Uuid
  levelId     String   @db.Uuid
  wordSenseId String   @db.Uuid
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  level     Level     @relation(fields: [levelId], references: [id], onDelete: Cascade)
  wordSense WordSense @relation(fields: [wordSenseId], references: [id], onDelete: Cascade)

  @@unique([levelId, wordSenseId])
  @@index([levelId])
  @@index([wordSenseId])
}

model StageWord {
  id          String   @id @default(uuid()) @db.Uuid
  stageId     String   @db.Uuid
  wordSenseId String   @db.Uuid
  isRequired  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  stage     Stage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  wordSense WordSense @relation(fields: [wordSenseId], references: [id], onDelete: Cascade)

  @@unique([stageId, wordSenseId])
  @@index([stageId])
  @@index([wordSenseId])
}

// ===== 第四批：用户单词掌握（UserWord / WritingRecord）=====
// 注意：User.id 是 text（旧表），故 userId 不加 @db.Uuid；
// WordSense.id 是 @db.Uuid，故 wordSenseId 用 @db.Uuid。
// WritingRecord.retryOfRecordId 自关联到错误记录，用 @db.Uuid。

model UserWord {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String
  wordSenseId    String    @db.Uuid
  status         String    @default("not_started")
  correctStreak  Int       @default(0)
  firstLearnedAt DateTime?
  lastTestedAt   DateTime?
  lastCorrectAt  DateTime?
  nextReviewAt   DateTime?
  masteredAt     DateTime?
  forgottenAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordSense WordSense @relation(fields: [wordSenseId], references: [id], onDelete: Cascade)

  @@unique([userId, wordSenseId])
  @@index([userId])
  @@index([wordSenseId])
  @@index([nextReviewAt])
}

model WritingRecord {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String
  wordSenseId           String   @db.Uuid
  inputAnswer           String
  isCorrect             Boolean
  isIndependent         Boolean  @default(true)
  attemptType           String   @default("scheduled")
  isValidMasteryAttempt Boolean  @default(true)
  retryOfRecordId       String?  @db.Uuid
  testedAt              DateTime @default(now())

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordSense     WordSense       @relation(fields: [wordSenseId], references: [id], onDelete: Cascade)
  retryOfRecord WritingRecord?  @relation("WritingRecordRetry", fields: [retryOfRecordId], references: [id], onDelete: SetNull)
  retries       WritingRecord[] @relation("WritingRecordRetry")

  @@index([userId])
  @@index([wordSenseId])
  @@index([testedAt])
}

// ===== 第五批：用户进度与每日任务 =====
// User.id 是 text → userId 不加 @db.Uuid；
// Stage.id / Level.id / WordSense.id 是 @db.Uuid → 对应外键用 @db.Uuid。
// learningDate 用 @db.Date（只存日期，不含时间）。

model UserStage {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String
  stageId     String    @db.Uuid
  status      String    @default("locked")
  unlockedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([userId, stageId])
  @@index([userId])
  @@index([stageId])
}

model UserLevel {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String
  levelId     String    @db.Uuid
  status      String    @default("locked")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  level Level @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@index([userId])
  @@index([levelId])
}

model DailyLearning {
  id                      String   @id @default(uuid()) @db.Uuid
  userId                  String
  learningDate            DateTime @db.Date
  newWordCount            Int      @default(0)
  reviewWordCount         Int      @default(0)
  masteredCount           Int      @default(0)
  isDailyMinimumCompleted Boolean  @default(false)
  sessionStatus           String   @default("in_progress")
  lastLearningPosition    String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, learningDate])
  @@index([userId])
  @@index([learningDate])
}

model DailyTask {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String
  learningDate DateTime  @db.Date
  wordSenseId  String    @db.Uuid
  taskType     String
  taskStatus   String    @default("pending")
  sequence     Int       @default(0)
  completedAt  DateTime?
  retryCount   Int       @default(0)
  createdAt    DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordSense WordSense @relation(fields: [wordSenseId], references: [id], onDelete: Cascade)

  @@unique([userId, learningDate, wordSenseId, taskType])
  @@index([userId])
  @@index([learningDate])
  @@index([wordSenseId])
}

model ReviewRecord {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String
  wordSenseId    String    @db.Uuid
  scheduledAt    DateTime
  completedAt    DateTime?
  result         String?
  sequenceNumber Int       @default(0)
  createdAt      DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordSense WordSense @relation(fields: [wordSenseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([wordSenseId])
  @@index([scheduledAt])
}
