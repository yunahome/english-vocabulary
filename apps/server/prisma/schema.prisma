generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Word {
  id        String   @id @default(uuid())
  word      String   @unique
  phonetic  String?
  meaning   String
  example   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  learningRecords LearningRecord[]

  @@index([createdAt])
}

model User {
  id        String   @id @default(uuid())
  openid    String?  @unique
  nickname  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  learningRecords LearningRecord[]
}

model LearningRecord {
  id             String    @id @default(uuid())
  userId         String
  wordId         String
  familiarity    Int       @default(0)
  reviewCount    Int       @default(0)
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId])
  @@index([wordId])
}

// ===== 第一批：课程管理（Stage / Unit / Level）=====
// 说明：StageWord / UserStage / LevelWord / UserLevel 属于后续批次，
// 这些关联字段会在对应模型创建后再补上，避免引用不存在的模型导致校验失败。

model Stage {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  sortOrder   Int      @default(0)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  units Unit[]

  @@index([sortOrder])
}

model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  stageId   String   @db.Uuid
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  stage  Stage   @relation(fields: [stageId], references: [id], onDelete: Restrict)
  levels Level[]

  @@unique([stageId, sortOrder])
  @@index([stageId])
}

model Level {
  id        String   @id @default(uuid()) @db.Uuid
  unitId    String   @db.Uuid
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([unitId, sortOrder])
  @@index([unitId])
}
