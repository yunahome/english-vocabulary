<view class="tb-holder">
  <view class="tb-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="path"
      class="tb-item"
      data-index="{{index}}"
      bindtap="onTap"
      hover-class="tb-item-hover"
      hover-stay-time="60"
    >
      <image
        class="tb-icon"
        src="{{selected === index ? item.activeIcon : item.icon}}"
        mode="aspectFit"
      />
      <text class="tb-label {{selected === index ? 'tb-label-active' : ''}}">{{item.label}}</text>
    </view>
  </view>
</view>
