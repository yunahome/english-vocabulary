/* 自定义 tabBar：白色圆角悬浮卡片，左右与底部露出页面奶油色背景 */
.tb-holder {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 0 16rpx;
  padding-bottom: 12rpx;
  padding-bottom: calc(12rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(255, 250, 242, 0) 0%, rgba(255, 250, 242, 0.92) 34%);
}

.tb-bar {
  display: flex;
  align-items: center;
  height: 116rpx;
  background: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 10rpx 28rpx rgba(31, 45, 36, 0.08), 0 2rpx 8rpx rgba(31, 45, 36, 0.04);
  box-sizing: border-box;
  pointer-events: auto;
}

.tb-item {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tb-item-hover {
  opacity: 0.72;
}

.tb-icon {
  width: 46rpx;
  height: 46rpx;
  display: block;
}

.tb-label {
  margin-top: 4rpx;
  font-size: 26rpx;
  line-height: 1.1;
  color: #9c9ea7;
  font-weight: 500;
}

.tb-label-active {
  color: #30ba6e;
  font-weight: 700;
}
